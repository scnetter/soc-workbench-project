# Azure OpenAI (OpenAI v1 SDK API Endpoint)
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_MODEL_NAME=gpt-5.1

# CrowdStrike Falcon API Credentials
FALCON_CLIENT_ID=your_falcon_client_id_here
FALCON_CLIENT_SECRET=your_falcon_client_secret_here
FALCON_BASE_URL=https://api.crowdstrike.com
FALCON_MCP_MODULES=detections,hosts,intel,spotlight,idp,ngsiem
