{
  "name": "soc-workbench",
  "version": "0.1.0",
  "description": "SOC Analyst Workbench built with LangGraph, Bun, TypeScript, and MCP",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/repl.ts",
    "dev": "bun --watch run src/repl.ts",
    "typecheck": "tsc --noEmit",
    "test:llm": "bun run src/test-llm.ts",
    "test:mcp": "bun run src/test-mcp.ts",
    "test:abuseipdb": "bun run src/test-abuseipdb.ts",
    "test:ipgeo": "bun run src/test-ipgeolocation.ts",
    "test:agent-geo": "bun run src/test-agent-geolocation.ts",
    "repl": "bun run src/repl.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
